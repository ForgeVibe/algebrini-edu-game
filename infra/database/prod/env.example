# Algebrini Production Database Configuration
# Copy this file to .env and modify with secure values

# PostgreSQL Configuration
POSTGRES_USER=algebrini_prod_user
POSTGRES_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD
POSTGRES_DB=algebrini_prod

# pgAdmin Configuration
PGADMIN_EMAIL=admin@algebrini.com
PGADMIN_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD
PGADMIN_MASTER_PASSWORD=CHANGE_THIS_TO_SECURE_MASTER_PASSWORD

# Redis Configuration
REDIS_PASSWORD=CHANGE_THIS_TO_SECURE_REDIS_PASSWORD

# Grafana Configuration
GRAFANA_PASSWORD=CHANGE_THIS_TO_SECURE_GRAFANA_PASSWORD

# Database Connection (for Flutter app)
DATABASE_URL=postgresql://algebrini_prod_user:CHANGE_THIS_TO_SECURE_PASSWORD@localhost:5432/algebrini_prod
REDIS_URL=redis://:CHANGE_THIS_TO_SECURE_REDIS_PASSWORD@localhost:6379

# Production Settings
NODE_ENV=production
LOG_LEVEL=info

# Security Settings
POSTGRES_SSL_MODE=require
POSTGRES_SSL_CERT=/path/to/ssl/cert
POSTGRES_SSL_KEY=/path/to/ssl/key
POSTGRES_SSL_CA=/path/to/ssl/ca

# Backup Settings
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM 