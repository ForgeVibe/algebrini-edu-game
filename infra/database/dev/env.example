# Algebrini Development Database Configuration
# Copy this file to .env and modify as needed

# PostgreSQL Configuration
POSTGRES_PASSWORD=algebrini_dev_password
POSTGRES_USER=algebrini_user
POSTGRES_DB=algebrini_dev

# pgAdmin Configuration
PGADMIN_EMAIL=admin@algebrini.dev
PGADMIN_PASSWORD=admin_password

# Redis Configuration (optional)
REDIS_PASSWORD=algebrini_redis_password

# Database Connection (for Flutter app)
DATABASE_URL=postgresql://algebrini_user:algebrini_dev_password@localhost:5432/algebrini_dev
REDIS_URL=redis://localhost:6379

# Development Settings
NODE_ENV=development
LOG_LEVEL=debug 